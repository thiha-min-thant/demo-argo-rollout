# Pinned versions for the Argo Rollouts canary lab.
# Verified against upstream releases on 2026-10-24. Bump here, nowhere else.
# Sourced by the bash scripts. Safe to `source` from fish as well.

export CLUSTER_NAME=rollouts-lab
export KUBE_CONTEXT="kind-$CLUSTER_NAME"

# kind v0.33.0 (2026-08-26). Default node image is Kubernetes v1.37.0.
export KIND_VERSION=v0.33.0
export K8S_VERSION=v1.37.0
export K8S_NODE_IMAGE='kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5'
# Fallback if you must stay one minor behind:
# export K8S_NODE_IMAGE='kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed'

# Gateway API standard channel, v1.6.3 (2026-10-06)
export GATEWAY_API_VERSION=v1.6.3

# Istio 1.31.3 (2026-10-22). Charts: https://blob.istio.io/istio-release/charts
export ISTIO_VERSION=1.31.3
export ISTIO_CHART_REPO=https://blob.istio.io/istio-release/charts

# Argo Rollouts v1.10.1 (2026-10-12) via argo-helm chart argo-rollouts-2.43.8 (2026-10-16)
export ARGO_ROLLOUTS_VERSION=v1.10.1
export ARGO_ROLLOUTS_CHART_VERSION=2.43.8

# Gateway API traffic-router plugin v0.17.0 (2026-09-01), image pinned by index digest
export GWAPI_PLUGIN_VERSION=v0.17.0
export GWAPI_PLUGIN_IMAGE='ghcr.io/argoproj-labs/rollouts-plugin-trafficrouter-gatewayapi:v0.17.0@sha256:bc40d5edf13307e455f6c18cbf9cc79715165cbee8b05a674fd88119f119d4a2'

# kube-prometheus-stack chart 92.13.1 (2026-10-24), Prometheus Operator v0.94.1
export KPS_CHART_VERSION=92.13.1

# Demo app: canarybird (https://github.com/thiha-min-thant/canarybird).
# One image; a new "version" is just VERSION=vN. The :dev tag is not published on ghcr.io yet
# (release.yml only pushes semver + latest on v* tags), so scripts/setup.sh builds this tag from
# CANARYBIRD_SRC and `kind load`s it when the pull fails.
export CANARYBIRD_IMAGE='ghcr.io/thiha-min-thant/canarybird:dev'
export CANARYBIRD_SRC="${CANARYBIRD_SRC:-$HOME/Code/github/canarybird}"
